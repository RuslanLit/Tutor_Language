From 0c870dc93dc65cb947653de0b327eac0835363de Mon Sep 17 00:00:00 2001
From: RuslanLit <arslanlitvin@gmail.com>
Date: Thu, 3 Sep 2026 08:01:55 +0300
Subject: [PATCH 2/2] Add UpdateCheckData and AutoName; apply canonical
 metadata formatting

- UpdateCheckData: the Flutter Android config reads versionName/versionCode
  from local.properties at build time, so UpdateCheckMode: Tags has nothing
  static in build.gradle.kts to parse without it.
- AutoName: Tutor Language (fdroid checkupdates re-derives and writes it).
- Formatting is the exact output of fdroid rewritemeta.
---
 metadata/org.tutorlanguage.app.yml | 23 +++++++++++------------
 1 file changed, 11 insertions(+), 12 deletions(-)

diff --git a/metadata/org.tutorlanguage.app.yml b/metadata/org.tutorlanguage.app.yml
index a8b5080ef..84a163053 100644
--- a/metadata/org.tutorlanguage.app.yml
+++ b/metadata/org.tutorlanguage.app.yml
@@ -1,3 +1,9 @@
+AntiFeatures:
+  NonFreeAssets:
+    en-US: The bundled Spanish reference speech in app/assets/languages/spanish/audio/reference/
+      is Generated Output of the proprietary Google Cloud Text-to-Speech service (voice
+      es-ES-Chirp3-HD-Charon). The app has no non-free code, network dependency, or
+      runtime service; only these pre-rendered WAV assets are non-free. See THIRD_PARTY_NOTICES.md.
 Categories:
   - Science & Education
 License: GPL-3.0-or-later
@@ -6,19 +12,11 @@ WebSite: https://github.com/RuslanLit/Tutor_Language
 SourceCode: https://github.com/RuslanLit/Tutor_Language
 IssueTracker: https://github.com/RuslanLit/Tutor_Language/issues
 
+AutoName: Tutor Language
+
 RepoType: git
 Repo: https://github.com/RuslanLit/Tutor_Language.git
 
-AntiFeatures:
-  NonFreeAssets:
-    en-US: >-
-      The bundled Spanish reference speech in
-      app/assets/languages/spanish/audio/reference/ is Generated Output of the
-      proprietary Google Cloud Text-to-Speech service (voice
-      es-ES-Chirp3-HD-Charon). The app has no non-free code, network
-      dependency, or runtime service; only these pre-rendered WAV assets are
-      non-free. See THIRD_PARTY_NOTICES.md.
-
 Builds:
   - versionName: 1.0.1
     versionCode: 2
@@ -30,12 +28,13 @@ Builds:
     prebuild:
       - export PUB_CACHE=$(pwd)/.pub-cache && $$flutter$$/bin/flutter config --no-analytics
       - export PUB_CACHE=$(pwd)/.pub-cache && $$flutter$$/bin/flutter pub get --enforce-lockfile
-    build:
-      - export PUB_CACHE=$(pwd)/.pub-cache && $$flutter$$/bin/flutter build apk --release
     scandelete:
       - app/.pub-cache
+    build: export PUB_CACHE=$(pwd)/.pub-cache && $$flutter$$/bin/flutter build apk
+      --release
 
 AutoUpdateMode: None
 UpdateCheckMode: Tags
+UpdateCheckData: app/pubspec.yaml|version:\s.+\+(\d+)|.|version:\s(.+)\+
 CurrentVersion: 1.0.1
 CurrentVersionCode: 2
-- 
