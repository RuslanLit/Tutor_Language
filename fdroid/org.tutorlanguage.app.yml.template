# USER INPUT REQUIRED after the real GitHub release exists:
# Binaries: https://github.com/RuslanLit/Tutor_Language/releases/download/v%v/TutorLanguage-%v.apk
# USER INPUT REQUIRED after the permanent developer key exists:
# AllowedAPKSigningKeys: CERTIFICATE_SHA256_WITHOUT_SEPARATORS

Builds:
  - versionName: 1.0.1
    versionCode: 2
    # NOT a constant: this must be bumped to the exact clean release commit for
    # EVERY new release (the commit that contains this recipe and the matching
    # versionName/versionCode). Current value = tag v1.0.1.
    commit: 4ef91e4a7ec50934bbefa360287a3415822af259
    subdir: app
    output: build/app/outputs/flutter-apk/app-release.apk
    srclibs:
      - flutter@3.44.9
    prebuild:
      - export PUB_CACHE=$(pwd)/.pub-cache && $$flutter$$/bin/flutter config --no-analytics
      - export PUB_CACHE=$(pwd)/.pub-cache && $$flutter$$/bin/flutter pub get --enforce-lockfile
    build:
      - export PUB_CACHE=$(pwd)/.pub-cache && $$flutter$$/bin/flutter build apk --release
    # subdir is `app`, so PUB_CACHE=$(pwd)/.pub-cache lands at <repo>/app/.pub-cache,
    # but scandelete is resolved from the repo root — hence the `app/` prefix.
    scandelete:
      - app/.pub-cache

AutoUpdateMode: None
UpdateCheckMode: Tags
CurrentVersion: 1.0.1
CurrentVersionCode: 2
