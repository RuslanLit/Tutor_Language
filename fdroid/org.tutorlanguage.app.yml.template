AntiFeatures:
  NonFreeAssets:
    en-US: >-
      The bundled Spanish reference speech in
      app/assets/languages/spanish/audio/reference/ is Generated Output of the
      proprietary Google Cloud Text-to-Speech service (voice
      es-ES-Chirp3-HD-Charon). The app has no non-free code, network
      dependency, or runtime service; only these pre-rendered WAV assets are
      non-free. See THIRD_PARTY_NOTICES.md.

# Deferred to v1.0.2 — v1.0.1 official APK was built at a developer-machine-
# specific path (/home/master/...), unsuitable for a public recipe. v1.0.2
# will be built at a neutral canonical path from the start, enabling
# upstream-signature reproducibility then.
# Binaries: https://github.com/RuslanLit/Tutor_Language/releases/download/v%v/TutorLanguage-%v-signed.apk

# Permanent developer release key (keystore: tutor-language-release.jks,
# alias tutor-language-release, RSA 4096). apksigner-reported certificate
# SHA-256, lowercase hex, no separators. Recorded now so a future Binaries
# release verifies against it; not enforced while F-Droid signs v1.0.1.
AllowedAPKSigningKeys: 4f5244d1f7a1c1801947397d8b48a736e8de0baf4132db13042e500cd14ea2c0

Builds:
  - versionName: 1.0.1
    versionCode: 2
    # Exact clean build point for this release. 02573807 = the 1.0.1 code
    # (slow playback 0.6x) plus the Android build pins and the jni
    # `-Wl,--build-id=none` workaround; it is the tree the published APK was
    # built from. This deliberately differs from the v1.0.1 tag (42cb6e5):
    # the tag identifies the version for UpdateCheckMode, `commit:` identifies
    # the exact build point. Bump every release.
    commit: 02573807f1e8ddedf3aedc3c39c49c7e2585062d
    subdir: app
    output: build/app/outputs/flutter-apk/app-release.apk
    srclibs:
      - flutter@3.44.9
    prebuild:
      - export PUB_CACHE=$(pwd)/.pub-cache && $$flutter$$/bin/flutter config --no-analytics
      - export PUB_CACHE=$(pwd)/.pub-cache && $$flutter$$/bin/flutter pub get --enforce-lockfile
    build:
      - export PUB_CACHE=$(pwd)/.pub-cache && $$flutter$$/bin/flutter build apk --release
    # subdir is `app`, so PUB_CACHE=$(pwd)/.pub-cache lands at <repo>/app/.pub-cache,
    # but scandelete is resolved from the repo root — hence the `app/` prefix.
    scandelete:
      - app/.pub-cache

AutoUpdateMode: None
UpdateCheckMode: Tags
CurrentVersion: 1.0.1
CurrentVersionCode: 2
