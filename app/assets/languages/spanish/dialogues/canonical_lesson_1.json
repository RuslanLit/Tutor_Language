    "lines": [
      {
        "speaker": "Ти",
        "spanish": "Hola. Buenos días.",
        "native_translation": "ола. буенос діас — привіт. доброго ранку."
      },
      {
        "speaker": "Ти",
        "spanish": "Me llamo Marta.",
        "native_translation": "ме ямо Марта — мене звати Marta."
      },
      {
        "speaker": "Ти",
        "spanish": "¿Cómo te llamas?",
        "audioReferenceId": "es.audio.question.como_te_llamas",
        "native_translation": "комо те ямас — як тебе звати?"
      },
      {
        "speaker": "Ana",
      "spanish": "Me llamo Ana.",
      "audioReferenceId": "es.audio.phrase.me_llamo",
        "native_translation": "ме ямо Ана — мене звати Ana."
      },
    {
      "speaker": "Ти",
      "spanish": "Mucho gusto.",
      "native_translation": "мучо густо — дуже приємно."
    },
    {
      "speaker": "Ти",
      "spanish": "Hasta luego.",
      "native_translation": "аста луего — до зустрічі."
    }
    ]
  },
  {
    "id": "dialogue.es.a0.m01.l001.variant_support",
    "title": "Варіанти в тому самому знайомстві",
    "vocabulary_ids": [
      "vocab.es.a0.m01.l001.buenas_tardes",
      "vocab.es.a0.m01.l001.buenas_noches",
