    ],
    "grammar_ids": [
      "grammar.es.a0.m01.l001.polite_variants"
    ],
    "lines": [
      {
        "speaker": "Ти",
        "spanish": "Buenas tardes.",
        "native_translation": "буенас тардес — добрий день."
      },
      {
        "speaker": "Ти",
        "spanish": "Buenas noches.",
        "native_translation": "буенас ночес — добрий вечір."
      },
      {
        "speaker": "Ти",
        "spanish": "Encantado.",
        "native_translation": "енкантадо — приємно познайомитися."
      },
      {
        "speaker": "Ana",
        "spanish": "Encantada.",
        "native_translation": "енкантада — приємно познайомитися."
      },
      {
        "speaker": "Ти",
        "spanish": "Por favor.",
        "native_translation": "пор фавор — будь ласка."
      },
      {
        "speaker": "Ana",
        "spanish": "No.",
        "native_translation": "но — ні."
      }
    ]
  }
