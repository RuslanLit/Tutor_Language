    "lines": [
      {
        "speaker": "Sofía",
        "spanish": "Buenos días. ¿Qué transporte tomo?",
        "native_translation": "Good morning. What transport do I take?"
      },
      {
        "speaker": "Pedro",
        "spanish": "Toma el autobús.",
        "native_translation": "Take the bus."
      },
      {
        "speaker": "Sofía",
        "spanish": "¿Dónde está la parada?",
        "native_translation": "Where is the stop?"
      },
      {
        "speaker": "Pedro",
        "spanish": "Sigue recto y gira a la derecha.",
        "native_translation": "Go straight and turn right."
      },
      {
        "speaker": "Sofía",
        "spanish": "Muchas gracias.",
        "native_translation": "Thank you very much."
      }
    ]
  }
