    "lines": [
      {
        "speaker": "Ana",
        "spanish": "Perdón, ¿dónde está la estación?",
        "native_translation": "Excuse me, where is the station?"
      },
      {
        "speaker": "Luis",
        "spanish": "Está cerca.",
        "native_translation": "It is near."
      },
      {
        "speaker": "Ana",
        "spanish": "Gracias.",
        "native_translation": "Thank you."
      }
    ]
  },
