    "lines": [
      {
        "speaker": "Elena",
        "spanish": "¿Cómo vas al centro?",
        "native_translation": "How do you go to the center?"
      },
      {
        "speaker": "Carlos",
        "spanish": "Voy en metro.",
        "native_translation": "I go by metro."
      },
      {
        "speaker": "Elena",
        "spanish": "Muy bien.",
        "native_translation": "Very good."
      }
