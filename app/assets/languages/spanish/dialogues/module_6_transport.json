    ],
    "lines": [
      {
        "speaker": "Marta",
        "spanish": "Hola, ¿cómo llego al hotel?",
        "native_translation": "Hello, how do I get to the hotel?"
      },
      {
        "speaker": "Diego",
        "spanish": "Sigue recto y gira a la izquierda.",
        "native_translation": "Go straight and turn left."
      },
      {
        "speaker": "Marta",
        "spanish": "Gracias.",
        "native_translation": "Thank you."
      }
    ]
