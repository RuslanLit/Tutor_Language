    ],
    "lines": [
      {
        "speaker": "Ти",
        "spanish": "Él es Luis. Se llama Luis.",
        "native_translation": "ель ес Луїс. се яма Луїс — це Luis. його звати Luis.",
        "audioReferenceId": "es.audio.dialogue.el_es_luis_se_llama_luis"
      },
      {
        "speaker": "Ти",
        "spanish": "Es de Ucrania y vive en Kyiv.",
        "native_translation": "ес де укранія і біве ен Київ — він з України і живе в Києві.",
        "audioReferenceId": "es.audio.dialogue.es_de_ucrania_y_vive_en_kyiv"
      },
      {
        "speaker": "Ти",
        "spanish": "Habla español un poco, pero no habla francés.",
        "native_translation": "абла еспаньйол ун поко, перо но абла франсес — він трохи говорить іспанською, але не говорить французькою.",
        "audioReferenceId": "es.audio.dialogue.habla_espanol_un_poco_pero_no_habla_frances"
      }
    ]
  }
]
