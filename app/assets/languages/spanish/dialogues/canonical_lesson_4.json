    "lines": [
      {
        "speaker": "Ana",
        "spanish": "¿Quién es él?",
        "native_translation": "к'єн ес ель — хто він?",
        "audioReferenceId": "es.audio.question.quien_es_el"
      },
      {
        "speaker": "Ти",
        "spanish": "Él es mi amigo. Se llama Luis.",
        "native_translation": "ель ес мі аміго. се яма Луїс — він мій друг. його звати Luis.",
        "audioReferenceId": "es.audio.dialogue.el_es_mi_amigo_se_llama_luis"
      },
      {
        "speaker": "Ти",
        "spanish": "Es de Ucrania. Vive en Kyiv.",
        "native_translation": "ес де укранія. біве ен Київ — він з України. він живе в Києві.",
        "audioReferenceId": "es.audio.dialogue.es_de_ucrania_vive_en_kyiv"
      },
      {
        "speaker": "Ти",
        "spanish": "Habla español un poco.",
        "native_translation": "абла еспаньйол ун поко — він трохи говорить іспанською.",
        "audioReferenceId": "es.audio.dialogue.habla_espanol_un_poco"
      }
    ]
  }
]
