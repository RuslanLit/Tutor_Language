    ],
    "lines": [
      {
        "speaker": "Ти",
        "spanish": "Hola. Me llamo Marta.",
        "native_translation": "ола. ме ямо Марта — привіт. мене звати Marta.",
        "audioReferenceId": "es.audio.dialogue.hola_me_llamo_marta"
      },
      {
        "speaker": "Ana",
        "spanish": "Hola, Marta. ¿Cómo estás?",
        "native_translation": "ола Марта. комо естас — привіт, Marta. як ти?",
        "audioReferenceId": "es.audio.question.hola_marta_como_estas"
      },
      {
        "speaker": "Ти",
        "spanish": "Estoy bien, gracias. ¿Y tú?",
        "native_translation": "естой б'єн грасіас. і ту — у мене все добре, дякую. а ти?",
        "audioReferenceId": "es.audio.question.estoy_bien_gracias_y_tu"
      },
      {
        "speaker": "Ana",
        "spanish": "Muy bien, gracias.",
        "native_translation": "муй б'єн грасіас — дуже добре, дякую.",
        "audioReferenceId": "es.audio.dialogue.muy_bien_gracias"
      },
      {
        "speaker": "Ти",
        "spanish": "¿Quién es ella?",
        "native_translation": "к'єн ес ея — хто вона?",
        "audioReferenceId": "es.audio.question.quien_es_ella"
      },
      {
        "speaker": "Ana",
        "spanish": "Ella es mi amiga. Se llama Sofía.",
        "native_translation": "ея ес мі аміга. се яма Софія — вона моя подруга. її звати Sofía.",
        "audioReferenceId": "es.audio.dialogue.ella_es_mi_amiga_se_llama_sofia"
      },
      {
        "speaker": "Ana",
        "spanish": "Es de España. Vive en Madrid.",
        "native_translation": "ес де еспанья. біве ен мадрід — вона з Іспанії. вона живе в Мадриді.",
        "audioReferenceId": "es.audio.dialogue.es_de_espana_vive_en_madrid"
      },
      {
        "speaker": "Ana",
        "spanish": "Habla español e inglés.",
        "native_translation": "абла еспаньйол е інглес — вона говорить іспанською та англійською.",
        "audioReferenceId": "es.audio.dialogue.habla_espanol_e_ingles"
      },
      {
        "speaker": "Ти",
        "spanish": "Mucho gusto. Hasta luego.",
        "native_translation": "мучо густо. аста луего — дуже приємно. до зустрічі.",
        "audioReferenceId": "es.audio.dialogue.mucho_gusto_hasta_luego"
      }
    ]
  },
  {
    "id": "dialogue.es.a0.m01.l004.model_man_profile",
