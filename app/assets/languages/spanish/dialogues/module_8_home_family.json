    "lines": [
      {
        "speaker": "Elena",
        "spanish": "Esta es mi familia.",
        "native_translation": "This is my family."
      },
      {
        "speaker": "Carlos",
        "spanish": "¿Quién es él?",
        "native_translation": "Who is he?"
      },
      {
        "speaker": "Elena",
        "spanish": "Es mi hermano. Se llama Luis.",
        "native_translation": "He is my brother. His name is Luis."
      },
      {
        "speaker": "Carlos",
        "spanish": "¿Dónde está Luis?",
        "native_translation": "Where is Luis?"
      },
      {
        "speaker": "Elena",
