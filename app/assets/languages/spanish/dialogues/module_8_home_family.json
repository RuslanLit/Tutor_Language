[
  {
    "id": "dialogue.es.a0.m08.identify_family.v1",
    "title": "Identifying family",
    "vocabulary_ids": [
      "vocab.es.a0.m08.hermana.v1",
      "vocab.es.a0.m08.quien.v1"
    ],
    "grammar_ids": [
      "grammar.es.a0.m08.family_identification.v1",
      "grammar.es.a0.m08.third_person_family_name.v1"
    ],
    "lines": [
      {
        "speaker": "Luis",
        "spanish": "¿Quién es ella?",
        "native_translation": "Who is she?"
      },
      {
        "speaker": "Ana",
        "spanish": "Es mi hermana.",
        "native_translation": "She is my sister."
      },
      {
        "speaker": "Luis",
        "spanish": "¿Cómo se llama?",
        "native_translation": "What is her name?"
      },
      {
        "speaker": "Ana",
        "spanish": "Se llama Marta.",
        "native_translation": "Her name is Marta."
      }
    ]
  },
  {
    "id": "dialogue.es.a0.m08.siblings_question.v1",
    "title": "Asking about siblings",
    "vocabulary_ids": [
      "vocab.es.a0.m08.hermanos.v1",
      "vocab.es.a0.m08.hermano.v1"
    ],
    "grammar_ids": [
      "grammar.es.a0.m08.tener_family.v1"
    ],
    "lines": [
      {
        "speaker": "Marta",
        "spanish": "¿Tienes hermanos?",
        "native_translation": "Do you have siblings?"
      },
      {
        "speaker": "Pablo",
        "spanish": "Sí, tengo un hermano.",
        "native_translation": "Yes, I have a brother."
      },
      {
        "speaker": "Marta",
        "spanish": "¿Cómo se llama?",
        "native_translation": "What is his name?"
      },
      {
        "speaker": "Pablo",
        "spanish": "Se llama Diego.",
        "native_translation": "His name is Diego."
      }
    ]
  },
  {
    "id": "dialogue.es.a0.m08.no_siblings.v1",
    "title": "Negative sibling answer",
    "vocabulary_ids": [
      "vocab.es.a0.m08.hermanos.v1"
    ],
    "grammar_ids": [
      "grammar.es.a0.m08.tener_family.v1"
    ],
    "lines": [
      {
        "speaker": "Sofia",
        "spanish": "¿Tienes hermanos?",
        "native_translation": "Do you have siblings?"
      },
      {
        "speaker": "Elena",
        "spanish": "No, no tengo hermanos.",
        "native_translation": "No, I do not have siblings."
      },
      {
        "speaker": "Sofia",
        "spanish": "Gracias.",
        "native_translation": "Thank you."
      },
      {
        "speaker": "Elena",
        "spanish": "De nada.",
        "native_translation": "You are welcome."
      }
    ]
  },
  {
