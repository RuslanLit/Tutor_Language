    "lines": [
      {
        "speaker": "Ana",
        "spanish": "Esta es mi casa.",
        "native_translation": "This is my home."
      },
      {
        "speaker": "Luis",
        "spanish": "¿Dónde está la cocina?",
        "native_translation": "Where is the kitchen?"
      },
      {
