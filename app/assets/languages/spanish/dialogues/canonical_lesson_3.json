    "lines": [
      {
        "speaker": "Ти",
        "spanish": "Hola. Me llamo Marta.",
        "native_translation": "ола. ме ямо Марта — привіт. мене звати Marta.",
        "audioReferenceId": "es.audio.dialogue.hola_me_llamo_marta"
      },
      {
        "speaker": "Ana",
        "spanish": "Hola, Marta. Me llamo Ana.",
        "native_translation": "ола Марта. ме ямо Ана — привіт, Marta. мене звати Ana.",
        "audioReferenceId": "es.audio.dialogue.hola_marta_me_llamo_ana"
      },
      {
        "speaker": "Ти",
        "spanish": "Mucho gusto. ¿Cómo estás?",
        "native_translation": "мучо густо. комо естас — дуже приємно. як ти?",
        "audioReferenceId": "es.audio.question.mucho_gusto_como_estas"
      },
      {
        "speaker": "Ana",
        "spanish": "Estoy bien, gracias. ¿Y tú?",
        "native_translation": "естой б'єн грасіас. і ту — у мене все добре, дякую. а ти?",
        "audioReferenceId": "es.audio.question.estoy_bien_gracias_y_tu"
      },
      {
        "speaker": "Ти",
        "spanish": "Muy bien, gracias.",
        "native_translation": "муй б'єн грасіас — дуже добре, дякую.",
        "audioReferenceId": "es.audio.dialogue.muy_bien_gracias"
      },
      {
        "speaker": "Ти",
        "spanish": "¿De dónde eres?",
        "native_translation": "де донде ерес — звідки ти?",
        "audioReferenceId": "es.audio.question.de_donde_eres"
      },
      {
        "speaker": "Ana",
        "spanish": "Soy de España. Vivo en Madrid.",
        "native_translation": "сой де еспанья. біво ен мадрід — я з Іспанії. я живу в Мадриді.",
        "audioReferenceId": "es.audio.dialogue.soy_de_espana_vivo_en_madrid"
      },
      {
        "speaker": "Ти",
        "spanish": "Gracias. Hasta luego.",
        "native_translation": "грасіас. аста луего — дякую. до зустрічі.",
        "audioReferenceId": "es.audio.dialogue.gracias_hasta_luego"
      },
      {
        "speaker": "Ana",
        "spanish": "De nada. Nos vemos.",
        "native_translation": "де нада. нос бемос — нема за що. побачимося.",
        "audioReferenceId": "es.audio.dialogue.de_nada_nos_vemos"
      }
    ]
  },
  {
    "id": "dialogue.es.a0.m01.l003.repair_and_farewell",
    "title": "Вибачення і завершення",
    "vocabulary_ids": [
      "vocab.es.a0.m01.l001.hola",
