      "vocab.es.a0.m01.l003.disculpa",
      "vocab.es.a0.m01.l003.lo_siento",
      "vocab.es.a0.m01.l003.mas_o_menos",
      "vocab.es.a0.m01.l003.hasta_pronto",
      "vocab.es.a0.m01.l003.que_tengas_un_buen_dia"
    ],
    "grammar_ids": [
      "grammar.es.a0.m01.l003.polite_repairs"
    ],
    "lines": [
      {
        "speaker": "Ти",
        "spanish": "Perdón. ¿Cómo te llamas?",
        "native_translation": "пердон. комо те ямас — перепрошую. як тебе звати?",
        "audioReferenceId": "es.audio.question.perdon_como_te_llamas"
      },
      {
        "speaker": "Ana",
        "spanish": "Me llamo Ana.",
        "native_translation": "ме ямо Ана — мене звати Ana.",
        "audioReferenceId": "es.audio.phrase.me_llamo"
      },
      {
        "speaker": "Ти",
        "spanish": "Disculpa. No hablo francés.",
        "native_translation": "діскульпа. но абло франсес — вибач. я не говорю французькою.",
        "audioReferenceId": "es.audio.dialogue.disculpa_no_hablo_frances"
      },
      {
        "speaker": "Ana",
        "spanish": "Está bien.",
        "native_translation": "еста б'єн — добре.",
        "audioReferenceId": "es.audio.dialogue.esta_bien"
      },
      {
        "speaker": "Ти",
        "spanish": "Lo siento. Hasta pronto.",
        "native_translation": "ло с'єнто. аста пронто — мені шкода. до скорого.",
        "audioReferenceId": "es.audio.dialogue.lo_siento_hasta_pronto"
      },
      {
        "speaker": "Ana",
        "spanish": "Que tengas un buen día.",
        "native_translation": "ке тенгас ун буен діа — гарного дня.",
        "audioReferenceId": "es.audio.dialogue.que_tengas_un_buen_dia"
      }
    ]
  }
]
