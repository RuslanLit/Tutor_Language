  "localizations": [
    {
      "id": "pronunciation.es.rule.silent_h.v1",
      "learnerHints": {
        "en": "h is silent",
        "ru": "h не произносится"
      },
      "explanations": {
        "en": "In Spanish, written h is usually silent.",
        "ru": "В испанском буква h обычно пишется, но не произносится."
      }
    },
    {
      "id": "pronunciation.es.rule.enye.v1",
      "learnerHints": {
        "en": "ny",
        "ru": "нь"
      },
      "explanations": {
        "en": "The letter ñ is a separate Spanish letter.",
        "ru": "Буква ñ — отдельная испанская буква; она передаёт мягкий носовой звук."
      }
    },
    {
      "id": "pronunciation.es.rule.j.v1",
      "learnerHints": {
        "en": "h-like",
        "ru": "х-подобный звук"
      },
      "explanations": {
        "en": "Spanish j is not English j.",
        "ru": "Испанская j не читается как английская j; в этом курсе она объясняется как твёрдый х-подобный звук."
      }
    },
    {
      "id": "pronunciation.es.rule.ll_y.v1",
      "learnerHints": {
        "en": "y-like",
        "ru": "близко к й"
      },
      "explanations": {
        "en": "The course uses a general beginner ll/y norm.",
        "ru": "В курсе ll и y объясняются через общий начальный ориентир: звук, близкий к й."
      }
    },
    {
      "id": "pronunciation.es.rule.primary_stress.v1",
      "learnerHints": {
        "en": "marked stress",
        "ru": "ударение отмечено"
      },
      "explanations": {
        "en": "Learner hints mark the stressed syllable.",
        "ru": "В подсказках ударение отмечается явно, чтобы не читать слово механически по буквам."
      }
    },
    {
      "id": "pronunciation.es.word.hola.v1",
      "learnerHints": {
        "en": "OH-lah",
        "ru": "о́ла"
      },
      "explanations": {
        "en": "The h is silent.",
        "ru": "Начальная h не произносится: читаем примерно «о́ла»."
      }
    },
    {
      "id": "pronunciation.es.word.adios.v1",
      "learnerHints": {
        "en": "ah-DYOHS",
        "ru": "адьо́с"
      },
      "explanations": {
        "en": "The written accent marks stress.",
        "ru": "Ударение падает на последний слог: адьо́с."
      }
    },
    {
      "id": "pronunciation.es.phrase.hasta_luego.v1",
      "learnerHints": {
        "en": "AHS-tah LWEH-goh",
        "ru": "а́ста луэ́го"
      },
      "explanations": {
        "en": "The h in hasta is silent.",
        "ru": "В hasta буква h не произносится; в luego сочетание ue читается слитно."
      }
    },
    {
      "id": "pronunciation.es.word.jose.v1",
      "learnerHints": {
        "en": "hoh-SEH",
        "ru": "хосе́"
      },
      "explanations": {
        "en": "The j is not English j.",
        "ru": "В José буква j читается как твёрдый х-подобный звук."
      }
    },
    {
      "id": "pronunciation.es.word.espana.v1",
      "learnerHints": {
        "en": "es-PAH-nyah",
        "ru": "эспа́нья"
      },
      "explanations": {
        "en": "The letter ñ is a separate Spanish letter.",
        "ru": "В España буква ñ передаёт мягкий носовой звук, близкий к «нь»."
      }
    },
    {
      "id": "pronunciation.es.word.autobus.v1",
      "learnerHints": {
        "en": "ow-toh-BOOS",
        "ru": "аутобу́с"
      },
      "explanations": {
        "en": "The written accent marks stress.",
        "ru": "Ударение падает на последний слог: аутобу́с."
      }
    }
  ]
