  {
    "id": "template.es.a0.m01.l004.independent_introduce_person",
    "exercise_type": "text_entry",
    "supported_goal_types": [
      "independent_communicative_profile"
    ],
    "required_object_types": [
      "dialogue"
    ],
    "prompt_template": "Представ себе і одну іншу людину іспанською.\n\nВведи 8-10 коротких речень. Напиши кожну відповідь з нового рядка.\n\nРозмова має: привітатися, назвати себе Marta, сказати як справи, представити Ana як подругу, назвати її ім'я, країну, місто, мови й завершити контакт.",
    "expected_answer": "Hola. Me llamo Marta.\nEstoy bien, gracias.\nEsta es Ana.\nElla es mi amiga.\nSe llama Ana.\nEs de España.\nVive en Madrid.\nHabla español e inglés.\nMucho gusto. Hasta luego.",
    "accepted_answers": [
      "Hola. Me llamo Marta.\nMuy bien, gracias.\nEsta es Ana.\nElla es mi amiga.\nSe llama Ana.\nEs de España.\nVive en Madrid.\nHabla español.\nGracias. Hasta luego.",
      "Hola. Me llamo Marta.\nEstoy bien, gracias.\nEste es Luis.\nÉl es mi amigo.\nSe llama Luis.\nEs de Ucrania.\nVive en Kyiv.\nHabla español un poco.\nHasta pronto."
    ]
  },
